# --- Base de donnees (Neon / Postgres) ---
# Recuperee dans le dashboard Neon (voir README section 1). Doit inclure ?sslmode=require en prod.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Serveur ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# Liste d'origines autorisees separees par des virgules. "*" autorise tout (pratique en dev).
CORS_ORIGIN=*

# --- Firebase Admin SDK ---
# Option A (recommandee pour Render / production) : le JSON complet du service account,
# encode en base64 sur une seule ligne.
# Comment l'obtenir : voir README section 2.
# Exemple de generation locale : base64 -w0 service-account.json  (Linux/Mac)
#                                 [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) (PowerShell)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B (alternative, variables separees si vous ne voulez pas manipuler du base64) :
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Attention: dans un fichier .env classique, remplacez les retours a la ligne de la cle
# privee par des \n litteraux (voir README section 2).
FIREBASE_PRIVATE_KEY=

# --- Paiement en ligne (CinetPay) ---
# A recuperer dans le dashboard CinetPay (https://app.cinetpay.com) apres creation du compte
# marchand : Parametres > Cle API (apikey) et Parametres > Site marchand (site_id).
# Tant que ces deux valeurs sont vides, le paiement en ligne est simplement indisponible dans
# l'app (message d'erreur clair), le reste de l'application continue de fonctionner.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# URLs publiques de l'app, utilisees pour construire les URLs de retour/notification envoyees a
# CinetPay. A ne changer que si le nom de domaine change.
BACKEND_PUBLIC_URL=https://excellent-prof-backend.onrender.com
WEB_PUBLIC_URL=https://excellent-prof.web.app
