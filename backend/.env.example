# --- Base de donnees (Neon / Postgres) ---
# Recuperee dans le dashboard Neon (voir README section 1). Doit inclure ?sslmode=require en prod.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Serveur ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# Liste d'origines autorisees separees par des virgules. "*" autorise tout (pratique en dev).
CORS_ORIGIN=*

# --- Firebase Admin SDK ---
# Option A (recommandee pour Render / production) : le JSON complet du service account,
# encode en base64 sur une seule ligne.
# Comment l'obtenir : voir README section 2.
# Exemple de generation locale : base64 -w0 service-account.json  (Linux/Mac)
#                                 [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) (PowerShell)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B (alternative, variables separees si vous ne voulez pas manipuler du base64) :
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Attention: dans un fichier .env classique, remplacez les retours a la ligne de la cle
# privee par des \n litteraux (voir README section 2).
FIREBASE_PRIVATE_KEY=
